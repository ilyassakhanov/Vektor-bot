TELEGRAM_BOT_TOKEN=your-bot-token-here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Ollama context window (payload options.num_ctx). Unset = Ollama's own
# default; a too-small value silently truncates context — set only if
# prompts approach the default window.
# OLLAMA_NUM_CTX=4096
# Ollama model keep-alive duration (payload keep_alive), e.g. 30m — a model
# unload resets the prompt cache. Unset = Ollama default.
# OLLAMA_KEEP_ALIVE=30m
# Comma-separated Telegram usernames (auth gate only — multiple users are
# fine; each user's KB data is scoped by their Telegram numeric id).
ALLOWED_USERNAMES=@some-user
EXEC_TIMEOUT=30
EXEC_MAX_OUTPUT_CHARS=4000
AGENT_MAX_ITERATIONS=8
CONVERSATION_MAX_MESSAGES=12
# Notional $/1M-token prices for estimated-cost reporting (a local Ollama
# costs $0 in reality); unset = built-in table defaults ($0.35 in / $1.25 out).
# LLM_PRICE_IN_PER_1M=0.35
# LLM_PRICE_OUT_PER_1M=1.25
# 9100 clashes with node-exporter (hostNetwork) forwarded to the host by
# Rancher Desktop when the dashboard/monitoring stack is running.
METRICS_PORT=9101
LOKI_PUSH_URL=
# In-cluster Loki push endpoint:
# LOKI_PUSH_URL=http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push
LOG_LEVEL=INFO
# Seconds to wait for the MCP CVE server to initialize before falling back
# to exec-only mode (default 10).
# MCP_STARTUP_TIMEOUT=10
# MCP CVE server subprocess command (space-separated; first token is the
# executable). Default: python mcp_servers/cve_server.py
# MCP_CVE_SERVER_CMD=python mcp_servers/cve_server.py
# Telegram document uploads (.txt/.md/.pdf/.docx; 20 MB Telegram cap) ingest into the KB when this is 1.
KB_ENABLED=1
KB_DB_PATH=data/vektor.db
# Chunking window (characters) and word-aligned overlap.
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=100
# Per-source result limits and fused top-k.
KB_VECTOR_LIMIT=20
KB_FTS_LIMIT=20
KB_TOP_K=5
# RRF k constant — score contribution 1/(k + rank).
KB_RRF_K=60
# 0 = vector-only keyword search off; missing FTS5 also degrades to
# vector-only with a warning.
KB_FTS_ENABLED=1
# LLM query expansion before retrieval (small model, temp 0, never fails).
KB_EXPANSION_ENABLED=1
# KB_EXPANSION_TIMEOUT=10.0
# KB_EXPANSION_TEMPERATURE=0.0
# Pointwise LLM rerank of fused hits after RRF (uses OLLAMA_EXPANSION_MODEL;
# failure or timeout falls back to RRF order).
KB_RERANK_ENABLED=1
# KB_RERANK_TIMEOUT=10.0
OLLAMA_EXPANSION_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

TELEGRAM_BOT_TOKEN=your-bot-token-here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Ollama context window (payload options.num_ctx). Unset = Ollama's own
# default; a too-small value silently truncates context — set only if
# prompts approach the default window.
# OLLAMA_NUM_CTX=4096
# Ollama model keep-alive duration (payload keep_alive), e.g. 30m — a model
# unload resets the prompt cache. Unset = Ollama default.
# OLLAMA_KEEP_ALIVE=30m
ALLOWED_USERNAMES=@some-user,@another-user
EXEC_TIMEOUT=30
EXEC_MAX_OUTPUT_CHARS=4000
AGENT_MAX_ITERATIONS=8
CONVERSATION_MAX_MESSAGES=12
# Notional $/1M-token prices for estimated-cost reporting (a local Ollama
# costs $0 in reality); unset = built-in table defaults ($0.35 in / $1.25 out).
# LLM_PRICE_IN_PER_1M=0.35
# LLM_PRICE_OUT_PER_1M=1.25
# 9100 clashes with node-exporter (hostNetwork) forwarded to the host by
# Rancher Desktop when the dashboard/monitoring stack is running.
METRICS_PORT=9101
LOKI_PUSH_URL=
# In-cluster Loki push endpoint:
# LOKI_PUSH_URL=http://loki-gateway.monitoring.svc.cluster.local/loki/api/v1/push
LOG_LEVEL=INFO
